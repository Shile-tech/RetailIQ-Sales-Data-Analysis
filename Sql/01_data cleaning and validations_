/*==================================================================================================================
5. CLEANING TABLE (dbo.returns)
====================================================================================================================
	PROCESS:

- Checks are carried out. -- checks for duplicates,broken foreign keys using JOINS.
- String values are standardized and trimmed for whitespaces.
- Columns are casted into the right data_types.
- Data were flagged using CASE WHEN statement.
- The cleaned data is inserted into a new table.


raw table   -- dbo.returns
clean table -- clean.returns
====================================================================================================================*/

--                     Check for duplicates.
SELECT
	return_id,
	COUNT(*) AS occurence
FROM dbo.returns
GROUP BY return_id
HAVING COUNT(*) > 1          -- No duplicate records.



--                     Check for broken foreign keys.

SELECT
 r.order_id
FROM dbo.returns r
LEFT JOIN clean.orders o
ON r.order_id = o.order_id         
WHERE o.order_id IS NULL           -- Missing order_id's in the order's table 
                                   -- Meaning some returned orders does not have a record in the order's table.



--                       CLEANING TABLE 
SELECT
	TRIM(return_id) AS return_id,
	TRIM(r.order_id)  AS order_id,
	CASE
		WHEN o.order_id IS NULL THEN 'Invalid - Broken FK'     -- Tables cant be joined with this keys.
		ELSE                         'Valid FK'
	END             AS order_id_flag,
	COALESCE (
				TRY_CONVERT(DATE,return_date,23),
				TRY_CONVERT(DATE,return_date,101),     -- source data is suppose to use this format.
				TRY_CONVERT(DATE,return_date,103),
				TRY_CONVERT(DATE,return_date,107),
				TRY_CONVERT(DATE,return_date,106)
				)   AS return_date,
	CASE
		WHEN TRIM(return_reason) IS NULL THEN 'Unknown'
		ELSE TRIM(return_reason)
	END             AS return_reason,
	TRY_CAST(REPLACE(refund_amount_USD,'$','') AS DECIMAL(18,2)) AS refund_amount_USD,
	TRIM(CONCAT(UPPER(LEFT(return_status,1)),LOWER(SUBSTRING(return_status,2,LEN(return_status))))) AS return_status

INTO clean.returns               -- Inserting into clean table.
FROM dbo.returns r
LEFT JOIN clean.orders o
ON r.order_id = o.order_id





/*==================================================================================================================
6. CLEANING TABLE (dbo.subscriptions)
====================================================================================================================
	PROCESS:

- Checks are carried out. -- checks for duplicates,broken foreign keys using JOINS.
- String values are standardized and trimmed for whitespaces.
- Columns are casted into the right data_types.
- Data were flagged using CASE WHEN statement.
- Staging table was used to conduct data quality checks before inserting into final table.
- The cleaned data is inserted into a new table.


raw table     -- dbo.subscriptions
staging table -- clean.subs
clean table   -- clean.subscriptions
====================================================================================================================*/

--                     Check for duplicates
SELECT
	subscription_id,
	COUNT(*) AS occurence
FROM dbo.subscriptions
GROUP BY subscription_id
HAVING COUNT(*) > 1                -- No duplicate records.


--                     Check for broken FK.
SELECT
	s.customer_id
FROM dbo.subscriptions s
LEFT JOIN clean.customers c
ON s.customer_id = c.customer_id
WHERE c.customer_id IS NULL        -- Empty result set, therefore no broken FK.



--                               CLEANING TABLE
SELECT
	TRIM(subscription_id) AS subscription_id,
	TRIM(customer_id)     AS customer_id,
	TRIM(CONCAT(UPPER(LEFT(plan_name,1)),LOWER(SUBSTRING(plan_name,2,LEN(plan_name))))) AS plan_name,
	TRY_CAST(REPLACE(monthly_fee_USD,'$','') AS DECIMAL(18,0))                          AS monthly_fee_USD,
	COALESCE (
				TRY_CONVERT(DATE,subscription_start,23),
				TRY_CONVERT(DATE,subscription_start,101),     -- source data is suppose to use this format.
				TRY_CONVERT(DATE,subscription_start,103),
				TRY_CONVERT(DATE,subscription_start,107),
				TRY_CONVERT(DATE,subscription_start,106)
				)   AS subscription_start,
	COALESCE (
				TRY_CONVERT(DATE,subscription_end,23),
				TRY_CONVERT(DATE,subscription_end,101),       -- source data is suppose to use this format.
				TRY_CONVERT(DATE,subscription_end,103),
				TRY_CONVERT(DATE,subscription_end,107),
				TRY_CONVERT(DATE,subscription_end,106)
				)   AS subscription_end,
	TRY_CAST(tenure_months AS DECIMAL(18,2))                     AS tenure_months,
	TRY_CAST(REPLACE(total_revenue_USD,'$','') AS DECIMAL(18,0)) AS total_revenue_USD,
	TRIM(CONCAT(UPPER(LEFT(subscription_status,1)),LOWER(SUBSTRING(subscription_status,2,LEN(subscription_status))))) AS subscription_status,
	CASE
		WHEN TRIM(cancellation_reason) IS NULL THEN 'Unknown'
		ELSE TRIM(cancellation_reason)
	END                  AS cancellation_reason,
	TRIM(payment_method) AS payment_method

INTO clean.subs
FROM dbo.subscriptions


--          Checks on date columns. Using datediff command to validate the tenure_months column data.
SELECT
	subscription_id,
	subscription_start,
	subscription_end,
	DATEDIFF(MONTH,subscription_start,subscription_end) AS diff,
	tenure_months,
	DATEDIFF(MONTH,subscription_start,subscription_end) - tenure_months AS check_
FROM clean.subscriptions
WHERE ABS(DATEDIFF(MONTH,subscription_start,subscription_end) - tenure_months) > 1


-- After reviewing, i will be deriving a new tenure_months column as it will contain a more complete information.

SELECT 
subscription_id,
customer_id,
plan_name,
monthly_fee_USD,
subscription_start,
subscription_end,
DATEDIFF(MONTH,subscription_start,subscription_end) AS derived_tenure_months,
total_revenue_USD,
subscription_status,
cancellation_reason,
payment_method

INTO clean.subscriptions
FROM clean.subs


