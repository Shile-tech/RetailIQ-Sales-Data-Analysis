WHERE acquisition_channel IS NULL



--           checks on date columns.  -- last_purchase_date older than acquisition_date (Impossible dates)
SELECT
	customer_id,
	acquisition_date,
	last_purchase_date,
	DATEDIFF(MONTH,acquisition_date,last_purchase_date) AS diff
FROM clean.customers
WHERE DATEDIFF(MONTH,acquisition_date,last_purchase_date) < 0        -- Empty result set, therefore valid dates.





/*==================================================================================================================
2. CLEANING TABLE (dbo.products)
====================================================================================================================
	PROCESS:

- Checks for duplicates. -- no duplicate record.
- strings columns are standardized and also trimmed for whitespaces.
- Columns are casted into the right data_types.
- With the help of a CTE, mathematical calculations were carried out to enable data richness.
- Data transformation was done as new columns were derived to flag necessary data entry.
- The cleaned data is inserted into a new table.


raw table   -- dbo.products
clean table -- clean.products
====================================================================================================================*/

--                       Check for duplicates
SELECT 
	product_id,
	COUNT(*) AS occurence
FROM dbo.products
GROUP BY product_id
HAVING COUNT(*) > 1         -- No duplicates.


--                     CLEANING TABLE 

WITH standardization AS 
(
	SELECT 
		TRIM(product_id)   AS product_id,
		TRIM(product_name) AS product_name,
		CASE
			WHEN LOWER(TRIM(category)) = 'beauty'           THEN 'Beauty'
			WHEN LOWER(TRIM(category)) = 'beuty'            THEN 'Beauty'
			WHEN LOWER(TRIM(category)) = 'books'            THEN 'Books'
			WHEN LOWER(TRIM(category)) = 'electronics'      THEN 'Electronics'
			WHEN LOWER(TRIM(category)) = 'food & beverages' THEN 'Food and Beverage'
			WHEN LOWER(TRIM(category)) = 'food & beverage'  THEN 'Food and Beverage'
			WHEN LOWER(TRIM(category)) = 'home & garden'    THEN 'Home and Garden'
			WHEN LOWER(TRIM(category)) = 'home&garden'      THEN 'Home and Garden'
			WHEN LOWER(TRIM(category)) = 'softwre'          THEN 'Software'
			WHEN LOWER(TRIM(category)) = 'sports'           THEN 'Sports'
			ELSE TRIM(category)
		END                                                          AS category,
		TRY_CAST(REPLACE(unit_cost_USD,'$','')  AS DECIMAL(18,2))    AS unit_cost_USD,
		TRY_CAST(REPLACE(unit_price_USD,'$','') AS DECIMAL(18,2))    AS unit_price_USD,
		ROUND(gross_margin_pct,1)                                    AS gross_margin_pct,
		TRY_CAST(stock_qty AS INT)                                   AS stock_qty,
		TRY_CAST(CASE
			        WHEN is_active = 0 THEN 'No'
			        WHEN is_active = 1 THEN 'Yes'
		         END AS VARCHAR(5))                                  AS is_active
	FROM dbo.products
)

	SELECT 
		product_id,
		product_name,
		category,
		CASE 
			WHEN unit_price_USD IS NOT NULL AND gross_margin_pct IS NOT NULL THEN ROUND(unit_price_USD - ((gross_margin_pct * unit_price_USD) / 100.0),2)
			ELSE unit_cost_USD
		END                       AS unit_cost_USD,
		CASE 
			WHEN unit_cost_USD IS NOT NULL AND gross_margin_pct IS NOT NULL  THEN ROUND((100.0 * unit_cost_USD) / (100 - gross_margin_pct),2)
			ELSE unit_price_USD
		END                       AS unit_price_USD,
		CASE 
			WHEN unit_price_USD IS NOT NULL AND unit_cost_USD IS NOT NULL    THEN ROUND((((unit_price_USD - unit_cost_USD) / unit_price_USD) * 100.0),1)
			ELSE gross_margin_pct
		END                       AS gross_margin_pct,
		CASE
			WHEN unit_cost_USD IS NULL AND  gross_margin_pct IS NULL THEN 'Missing Data'
			ELSE                                                          'Complete Data'
		END                       AS data_entry_flag,
		stock_qty,
		CASE
			WHEN stock_qty < 0 THEN 'Error - Review'
			ELSE                    'valid'
		END                       AS stock_qty_flag,               --Inventory cant have a negative value.
		is_active

	INTO clean.products             -- Inserting into clean table.
	FROM standardization





