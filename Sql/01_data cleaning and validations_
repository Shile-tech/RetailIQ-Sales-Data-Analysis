		WHEN LOWER(TRIM(region)) = 'asia-pacific'    THEN 'Asia Pacific'
		WHEN LOWER(TRIM(region)) = 'apac'            THEN 'Asia Pacific'
		WHEN LOWER(TRIM(region)) = 'europe'          THEN 'Europe'
		WHEN LOWER(TRIM(region)) = 'eur'             THEN 'Europe'
		WHEN LOWER(TRIM(region)) = 'european region' THEN 'Europe'
		WHEN LOWER(TRIM(region)) = 'latin america'   THEN 'Latin America'
		WHEN LOWER(TRIM(region)) = 'latam'           THEN 'Latin America'
		WHEN LOWER(TRIM(region)) = 'middle east'     THEN 'Middle East'
		WHEN LOWER(TRIM(region)) = 'me'              THEN 'Middle East'
		WHEN LOWER(TRIM(region)) = 'mid east'        THEN 'Middle East'
		WHEN LOWER(TRIM(region)) = 'north america'   THEN 'North America'
		WHEN LOWER(TRIM(region)) = 'n. america'      THEN 'North America'
		ELSE TRIM(region)
	END              AS region,
	TRIM(country)    AS country

