--                       Check for duplicates
SELECT 
	order_id,
	COUNT(*) AS occurence
FROM dbo.orders
GROUP BY order_id
HAVING COUNT(*) > 1                -- No duplicates record exist.


--                         Check for broken Foreign key (FK).     
SELECT 
	o.customer_id
FROM dbo.orders o
LEFT JOIN clean.customers c
ON o.customer_id = c.customer_id
WHERE c.customer_id IS NULL        -- no result set, therefore no broken foreign keys.


--                      CLEANING TABLE

SELECT
	TRIM(order_id)    AS order_id,
	TRIM(customer_id) AS customer_id,
	COALESCE (
				TRY_CONVERT(DATE,order_date,23),
				TRY_CONVERT(DATE,order_date,101),     -- source data is suppose to use this format.
				TRY_CONVERT(DATE,order_date,103),
				TRY_CONVERT(DATE,order_date,107),
