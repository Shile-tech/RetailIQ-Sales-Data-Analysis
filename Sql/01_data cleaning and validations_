			 )        AS order_date,
	TRIM(CONCAT(UPPER(LEFT(order_status,1)),LOWER(SUBSTRING(order_status,2,LEN(order_status))))) AS order_status,
	CASE
		WHEN sales_channel IS NULL THEN 'Unknown'
		ELSE TRIM(sales_channel)
	END               AS sales_channel,
	TRY_CAST(REPLACE(shipping_cost_USD,'$','') AS DECIMAL(18,2)) AS shipping_cost_USD,
	TRY_CAST(ROUND((discount_pct * 100.0),0) AS INT)             AS discount_pct,
