/*==================================================================================================================
1. CLEANING TABLE (dbo.customers)
====================================================================================================================
	PROCESS:

- Duplicate records are inspected and handled using window functions and CTE.
- String values are standardized using CASE WHEN statement,also trimmed for white spaces.
- Messy dates are corrected and converted  date data_type.
- NULLs were handled.
- Data Manipulation (DML) is carried out to update necessary tables.
- The cleaned data is inserted into a new table.


raw table   -- dbo.customers
clean table -- clean.customers
====================================================================================================================*/

--              CHECK FOR DUPLICATES 

SELECT 
	customer_id,
	COUNT(*) AS occurence
FROM dbo.customers
GROUP BY customer_id
HAVING COUNT(*) > 1                           -- DUPLICATES EXIST        


--              INSPECTING DUPLICATES   

SELECT 
	*,
	ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY lifetime_value_USD DESC) AS rn
FROM dbo.customers
WHERE customer_id IN 
					(
						SELECT 
							customer_id
						FROM dbo.customers
						GROUP BY customer_id
						HAVING COUNT(*) > 1
					)                            --After inspecting, records with row number (rn) 1 stays, although they have the same lifetime_value, rn 1 has least missing values.               



--                                     CLEANING TABLE

WITH firt_step AS
(
	SELECT 
		TRIM(customer_id)   AS customer_id,
		TRIM(CONCAT(UPPER(LEFT(first_name,1)),LOWER(SUBSTRING(first_name,2,LEN(first_name))))) AS first_name,
		TRIM(CONCAT(UPPER(LEFT(last_name,1)),LOWER(SUBSTRING(last_name,2,LEN(last_name)))))    AS last_name,
		LOWER(TRIM(email))  AS email,
		CASE
			WHEN LOWER(TRIM(segment)) = 'enterprise'     THEN 'Enterprise'
			WHEN LOWER(TRIM(segment)) = 'government'     THEN 'Government'
			WHEN LOWER(TRIM(segment)) = 'individual'     THEN 'Individual'
			WHEN LOWER(TRIM(segment)) = 'smb'            THEN 'SMB'
			WHEN LOWER(TRIM(segment)) = 'startup'        THEN 'Startup'
			ELSE TRIM(segment)
		END                 AS segment,
		CASE
			WHEN LOWER(TRIM(region)) = 'africa'          THEN 'Africa'
			WHEN LOWER(TRIM(region)) = 'african region'  THEN 'Africa'
			WHEN LOWER(TRIM(region)) = 'asia pacific'    THEN 'Asia Pacific'
			WHEN LOWER(TRIM(region)) = 'asia-pacific'    THEN 'Asia Pacific'
			WHEN LOWER(TRIM(region)) = 'apac'            THEN 'Asia Pacific'
			WHEN LOWER(TRIM(region)) = 'europe'          THEN 'Europe'
			WHEN LOWER(TRIM(region)) = 'eur'             THEN 'Europe'
			WHEN LOWER(TRIM(region)) = 'european region' THEN 'Europe'
			WHEN LOWER(TRIM(region)) = 'latin america'   THEN 'Latin America'
			WHEN LOWER(TRIM(region)) = 'latam'           THEN 'Latin America'
			WHEN LOWER(TRIM(region)) = 'middle east'     THEN 'Middle East'
			WHEN LOWER(TRIM(region)) = 'me'              THEN 'Middle East'
			WHEN LOWER(TRIM(region)) = 'mid east'        THEN 'Middle East'
			WHEN LOWER(TRIM(region)) = 'north america'   THEN 'North America'
			WHEN LOWER(TRIM(region)) = 'n. america'      THEN 'North America'
			ELSE TRIM(region)
		END                                           AS region,
		TRIM(country)                                 AS country,
		TRIM(industry)                                AS industry,
		TRIM(acquisition_channel)                     AS acquisition_channel,
		COALESCE (
					TRY_CONVERT(DATE,acquisition_date,23),   
					TRY_CONVERT(DATE,acquisition_date,101),     -- source data is suppose to use this format.
					TRY_CONVERT(DATE,acquisition_date,103),
					TRY_CONVERT(DATE,acquisition_date,107),
					TRY_CONVERT(DATE,acquisition_date,106)
					)                                  AS acquisition_date,
		COALESCE (
					TRY_CONVERT(DATE,last_purchase_date,23),   
					TRY_CONVERT(DATE,last_purchase_date,101),   -- source data is suppose to use this format.
					TRY_CONVERT(DATE,last_purchase_date,103),
					TRY_CONVERT(DATE,last_purchase_date,107),
					TRY_CONVERT(DATE,last_purchase_date,106)
					)                                  AS last_purchase_date,
		TRIM(activity_status)                          AS activity_status,
		TRY_CAST(lifetime_value_USD AS DECIMAL (18,2)) AS lifetime_value_USD,
		ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY lifetime_value_USD DESC) AS rn
	FROM dbo.customers
)

	SELECT
		customer_id,
		first_name,
		last_name,
		email,
		segment,
		region,
		country,
		industry,
		acquisition_channel,
		acquisition_date,
		last_purchase_date,
		activity_status,
		lifetime_value_USD

	INTO clean.customers               -- Inserting into clean table.
	FROM firt_step
	WHERE rn = 1                       -- Removing duplicates from the record.



--                     Updating columns and filling in NULLs

UPDATE clean.customers
SET   industry    = 'Logistics'
WHERE customer_id = 'CUST-0174'        -- Customer's industry record was obtained from the deleted duplictes.


UPDATE clean.customers
SET   industry = 'Unknown'
WHERE industry IS NULL


